    },
    "navigationItems": {
      "type": "component",
      "component": "shared.navigation-item",
      "repeatable": true
    },
    "headerCTA": {
      "type": "component",
      "component": "shared.cta-button",
      "repeatable": true
    },
    "Footer": {
      "type": "component",
