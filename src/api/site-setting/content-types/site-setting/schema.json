{
  "kind": "collectionType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "SiteName": {
      "type": "string"
    },
    "Logo": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Favicon": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Tagline": {
      "type": "string"
    },
    "ContactInformation": {
      "type": "string"
    },
    "Navigation": {
      "type": "component",
      "component": "shared.navigation-item",
      "repeatable": true
    },
    "GetStartedButton": {
      "type": "component",
      "component": "shared.cta-button",
      "repeatable": false
    }
  }
}
